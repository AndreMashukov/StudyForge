rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailVerificationExempt(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return userDoc != null
        && userDoc.data != null
        && userDoc.data.get('emailVerificationExempt', false) == true;
    }

    function canAccessWorkspace(userId) {
      return isOwner(userId)
        && (
          request.auth.token.email_verified == true
          || isEmailVerificationExempt(userId)
        );
    }

    function isBoundedList(maxLimit) {
      return request.query.limit != null
        && request.query.limit > 0
        && request.query.limit <= maxLimit;
    }

    // Generation-owned fields must not change on client updates.
    function generationFieldsUnchanged() {
      return request.resource.data.get('generationStatus', null)
          == resource.data.get('generationStatus', null)
        && request.resource.data.get('generationError', null)
          == resource.data.get('generationError', null)
        && request.resource.data.get('generationModel', null)
          == resource.data.get('generationModel', null)
        && request.resource.data.get('generationModelUsage', null)
          == resource.data.get('generationModelUsage', null)
        && request.resource.data.get('completedAt', null)
          == resource.data.get('completedAt', null);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list, create, update, delete: if false;

      // Documents — generation creates; client may edit metadata/content and delete.
      match /documents/{documentId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if canAccessWorkspace(userId) && isBoundedList(100);
        allow create: if false;
        allow update: if canAccessWorkspace(userId) && generationFieldsUnchanged();
        allow delete: if canAccessWorkspace(userId);

        match /{nestedPath=**} {
          allow read, write: if false;
        }
      }

      match /quizzes/{quizId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if canAccessWorkspace(userId) && isBoundedList(50);
        allow create: if false;
        allow update: if canAccessWorkspace(userId) && generationFieldsUnchanged();
        allow delete: if canAccessWorkspace(userId);

        match /{nestedPath=**} {
          allow read, write: if false;
        }
      }

      match /directories/{directoryId} {
        function isValidDirectory() {
          return request.resource.data.name is string &&
                 request.resource.data.name.size() > 0 &&
                 request.resource.data.name.size() <= 100 &&
                 request.resource.data.level >= 0 &&
                 request.resource.data.level <= 10;
        }

        allow read: if canAccessWorkspace(userId);
        allow create: if canAccessWorkspace(userId) && isValidDirectory();
        allow update: if canAccessWorkspace(userId) && isValidDirectory();
        allow delete: if canAccessWorkspace(userId);

        match /items/{itemId} {
          allow read: if canAccessWorkspace(userId);
          allow create, update, delete: if canAccessWorkspace(userId);
        }

        match /chat/{threadId} {
          allow read: if canAccessWorkspace(userId);
          allow create, update: if canAccessWorkspace(userId);
          allow delete: if false;

          match /messages/{messageId} {
            allow read: if canAccessWorkspace(userId);
            allow write: if false;
          }
        }

        match /{otherNested=**} {
          allow read, write: if false;
        }
      }

      match /rules/{ruleId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if canAccessWorkspace(userId) && isBoundedList(100);
        allow create, update, delete: if canAccessWorkspace(userId);

        match /{nestedPath=**} {
          allow read, write: if false;
        }
      }

      match /flashcardSets/{flashcardSetId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if canAccessWorkspace(userId) && isBoundedList(50);
        allow create: if false;
        allow update: if canAccessWorkspace(userId) && generationFieldsUnchanged();
        allow delete: if canAccessWorkspace(userId);

        match /{nestedPath=**} {
          allow read, write: if false;
        }
      }

      match /learnedVocabulary/{itemId} {
        allow read, write: if canAccessWorkspace(userId);
      }

      match /slideDecks/{slideDeckId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if canAccessWorkspace(userId) && isBoundedList(50);
        allow create: if false;
        allow update: if canAccessWorkspace(userId) && generationFieldsUnchanged();
        allow delete: if canAccessWorkspace(userId);

        match /{nestedPath=**} {
          allow read, write: if false;
        }
      }

      match /diagramQuizzes/{diagramQuizId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if canAccessWorkspace(userId) && isBoundedList(50);
        allow create: if false;
        allow update: if canAccessWorkspace(userId) && generationFieldsUnchanged();
        allow delete: if canAccessWorkspace(userId);

        match /{nestedPath=**} {
          allow read, write: if false;
        }
      }

      match /sequenceQuizzes/{sequenceQuizId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if canAccessWorkspace(userId) && isBoundedList(50);
        allow create: if false;
        allow update: if canAccessWorkspace(userId) && generationFieldsUnchanged();
        allow delete: if canAccessWorkspace(userId);

        match /{nestedPath=**} {
          allow read, write: if false;
        }
      }

      match /matchQuizzes/{matchQuizId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if canAccessWorkspace(userId) && isBoundedList(50);
        allow create: if false;
        allow update: if canAccessWorkspace(userId) && generationFieldsUnchanged();
        allow delete: if canAccessWorkspace(userId);

        match /{nestedPath=**} {
          allow read, write: if false;
        }
      }

      match /generationJobs/{jobId} {
        allow read, write: if false;
      }

      match /interactionSessions/{sessionId} {
        allow read: if canAccessWorkspace(userId);
        allow create: if canAccessWorkspace(userId);
        allow update, delete: if false;
      }

      match /interactionStats/{statId} {
        allow read: if canAccessWorkspace(userId);
        allow create, update: if canAccessWorkspace(userId);
        allow delete: if false;
      }

      match /learningEvents/{eventId} {
        allow read: if canAccessWorkspace(userId);
        allow create: if canAccessWorkspace(userId);
        allow update, delete: if false;
      }

      match /quizAttempts/{attemptId} {
        allow read: if canAccessWorkspace(userId);
        allow create: if canAccessWorkspace(userId);
        allow update, delete: if false;
      }

      match /quizStats/{statId} {
        allow read: if canAccessWorkspace(userId);
        allow create, update: if canAccessWorkspace(userId);
        allow delete: if false;
      }

      match /questionStats/{statId} {
        allow read: if canAccessWorkspace(userId);
        allow create, update: if canAccessWorkspace(userId);
        allow delete: if false;
      }

      match /knowledgeStats/{statId} {
        allow read: if canAccessWorkspace(userId);
        allow create, update: if canAccessWorkspace(userId);
        allow delete: if false;
      }

      match /apiRateLimits/{limitId} {
        allow read, write: if false;
      }

      match /apiKeys/{keyId} {
        allow get, list: if canAccessWorkspace(userId);
        allow create, update, delete: if false;
      }

      match /usageSummary/{summaryId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /billing/{billingDocId} {
        allow get: if canAccessWorkspace(userId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /usagePeriods/{periodKey} {
        allow read, write: if false;
      }

      match /usageReservations/{reservationId} {
        allow read, write: if false;
      }

      match /usageEvents/{eventId} {
        allow read, write: if false;
      }

      match /llmUsageEvents/{eventId} {
        allow read, write: if false;
      }

      match /providerCostPeriods/{periodKey} {
        allow read, write: if false;
      }

      match /agentThreads/{threadId} {
        allow read: if canAccessWorkspace(userId);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if canAccessWorkspace(userId);
          allow write: if false;
        }
      }

      match /agentConversationMemories/{memoryId} {
        allow read, write: if false;
      }

      match /agentKnowledgeChunks/{chunkId} {
        allow read, write: if false;
      }
    }

    match /providerCostPeriods/{periodKey} {
      allow read, write: if false;
    }

    match /providerRateCatalog/{docId} {
      allow read, write: if false;
    }
  }
}
